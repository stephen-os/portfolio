# Copy to .env.local for development, and set the same variables in your
# host's dashboard for production. .env.local is gitignored; this file is not.


# --- Required in production -------------------------------------------------

# Absolute origin of the deployed site, no trailing slash.
# Drives metadataBase, canonical URLs, sitemap.xml, robots.txt and every Open
# Graph image URL. If unset it falls back to http://localhost:3000, which means
# a deployed sitemap would advertise localhost URLs to search engines and every
# link preview would break. Set this before going live.
NEXT_PUBLIC_SITE_URL=https://your-domain.dev


# --- Contact form -----------------------------------------------------------

# Resend API key. Without it /api/contact returns 503 and the form cannot send.
# Create one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional. Sender address for contact-form mail. Requires a domain verified
# with Resend. Defaults to onboarding@resend.dev, which works for testing.
# CONTACT_FROM=you@your-domain.dev
